{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["ship", "fix-first"],
      "description": "ship = no P0/P1 findings left"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "problem", "why_it_breaks", "fix"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"],
            "description": "P0 data loss/security/crash · P1 wrong result for real users · P2 edge case · P3 minor"
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "problem": { "type": "string" },
          "why_it_breaks": { "type": "string", "description": "Concrete input or state that triggers it" },
          "fix": { "type": "string" }
        }
      }
    }
  }
}
